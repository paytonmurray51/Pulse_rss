# Copy this file to terraform.tfvars and fill in your values.
# Do NOT commit terraform.tfvars — it is gitignored.
# Sensitive values (anthropic_api_key, db_password) should be passed
# via -var flags from GitHub Secrets in CI, not stored here.

project_id                = "utopian-hearth-161821"
region                    = "us-central1"
cloud_sql_instance_name   = "pulse-db"
cloud_sql_connection_name = "utopian-hearth-161821:us-central1:pulse-db"
artifact_registry_repo    = "pulse"
image_tag                 = "latest"
refresh_interval_minutes  = 30

# Set via -var in CI from GitHub Secrets:
# anthropic_api_key = "sk-ant-..."
# db_password       = "..."
