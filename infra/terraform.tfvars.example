# Copy this file to terraform.tfvars and fill in your values.
# Do NOT commit terraform.tfvars — it is gitignored.
# Sensitive values (anthropic_api_key, db_password) should be passed
# via -var flags from GitHub Secrets in CI, not stored here.

project_id                = "utopian-hearth-161821"
region                    = "us-central1"
# Existing shared instance — Terraform creates only the `pulse` database
# and `pulse_user` on it, and never touches the other databases.
cloud_sql_instance_name   = "mealie-db"
cloud_sql_connection_name = "utopian-hearth-161821:us-central1:mealie-db"
artifact_registry_repo    = "pulse"
image_tag                 = "latest"
refresh_interval_minutes  = 30

# Set via -var in CI from GitHub Secrets:
# anthropic_api_key = "sk-ant-..."
# db_password       = "..."

# Multi-user auth. owner_email is auto-invited and made admin on first boot.
owner_email      = "paytonmurray51@gmail.com"
google_client_id = "1234567890-abcdef.apps.googleusercontent.com"
public_url       = "https://pulse-748067667101.us-central1.run.app"
resend_from      = "Pulse <onboarding@resend.dev>"

# Set via -var in CI from GitHub Secrets:
# google_client_secret = "GOCSPX-..."
# session_secret       = "<openssl rand -base64 48>"
# resend_api_key       = "re_..."
